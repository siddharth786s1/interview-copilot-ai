# =============================================================================
# Interview Copilot AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (pick one and set the corresponding key)
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Options: gemini | openai

# Google Gemini (free tier: 15 req/min, 1500 req/day)
# Get key: https://aistudio.google.com
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (optional alternative)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Speech-to-Text Provider
# -----------------------------------------------------------------------------
STT_PROVIDER=whisper
# Options: whisper (local, free) | deepgram (cloud) | openai_whisper (cloud)

# Local Whisper model size (tiny | base | small | medium | large-v3)
# 'base' recommended — good accuracy, fast on CPU
WHISPER_MODEL_SIZE=base

# Deepgram (optional cloud STT — better latency, verify free tier)
# Get key: https://deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Options: development | production

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# A random string for internal app security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET=change-me-to-a-random-string

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_PATH=./storage
# Absolute or relative path to the local storage directory

# -----------------------------------------------------------------------------
# Backend Server & CORS
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed frontend origins (e.g., https://your-app.vercel.app,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments (e.g., https://.*\.vercel\.app)
CORS_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
